# ==============================================================================
# Railway / Production Environment Variables for GraniteMeasure Backend
# ==============================================================================

# Database
# In Railway: If you attach a PostgreSQL database, Railway automatically sets DATABASE_URL.
# GraniteMeasure automatically handles postgresql://, postgres://, and postgresql+psycopg://
DATABASE_URL=sqlite:///./granitemeasure.db
DATABASE_INIT_MODE=create

# Redis / Queue
# In Railway: If you attach a Redis database, Railway automatically sets REDIS_URL.
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage

# Supabase Storage (optional, only if STORAGE_BACKEND=supabase)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=granitemeasure

# CORS Origins
# Put your frontend Railway domain, Vercel domain, or * for all
CORS_ORIGINS=*

# Application settings
DEMO_MODE=false
SEED_DEMO_USERS=true

# Port (injected automatically by Railway)
PORT=8000
