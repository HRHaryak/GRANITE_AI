# GraniteMeasure AI — environment template
# Copy to frontend/.env.local and backend/.env (or use docker-compose env)

# --- Frontend (public) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: show a visible banner only when the API also has DEMO_MODE=true
NEXT_PUBLIC_APP_NAME=GraniteMeasure AI

# --- Backend ---
DATABASE_URL=postgresql+psycopg://granite:granite@localhost:5432/granitemeasure
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=granitemeasure

# Local file storage when Supabase Storage is not configured
LOCAL_STORAGE_DIR=./storage
STORAGE_BACKEND=local

# CORS
CORS_ORIGINS=http://localhost:3000

# AI models — if unset, granite/defect/segmentation AI providers return configuration errors (never fake detection)
GRANITE_DETECTION_MODEL_PATH=
GRANITE_SEGMENTATION_MODEL_PATH=
DEFECT_DETECTION_MODEL_PATH=

# ArUco physical size in centimetres (must match printed marker)
ARUCO_MARKER_SIZE_CM=10.0
ARUCO_DICTIONARY=DICT_5X5_100

# Image limits
MAX_IMAGE_BYTES=15728640
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

# Explicit demo simulation. Production must leave this false.
# When true, UI must show: DEMO MODE — SIMULATED RESULTS
DEMO_MODE=false

# Hackathon demo user seed (never runs unless you execute scripts/seed_demo_users.py)
SEED_DEMO_USERS=false

# Optional default density (t/m³) for indicative mass. Leave empty to forbid volume→tonne conversion.
DEFAULT_GRANITE_DENSITY_T_M3=

# Rate limiting
RATE_LIMIT_PER_MINUTE=120
