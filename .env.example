# GraniteMeasure AI — environment template
# Copy to frontend/.env.local and backend/.env (or use docker-compose env)

# --- Frontend (public) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: show a visible banner only when the API also has DEMO_MODE=true
NEXT_PUBLIC_APP_NAME=GraniteMeasure AI

# --- Backend ---
DATABASE_URL=postgresql+psycopg://granite:granite@localhost:5432/granitemeasure
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=granitemeasure

# Local file storage when Supabase Storage is not configured
LOCAL_STORAGE_DIR=./storage
STORAGE_BACKEND=local

# CORS
CORS_ORIGINS=http://localhost:3000

# ---- AI Model Weights ----
# When unset, each provider returns an honest "unavailable" status — no fake detection results.

# Granite slab object detection (YOLO11 / YOLO8)
GRANITE_DETECTION_MODEL_PATH=

# Granite surface segmentation (YOLO11-Seg)
GRANITE_SEGMENTATION_MODEL_PATH=

# SAM2 (Segment Anything v2) for segmentation refinement
SAM2_MODEL_PATH=
SAM2_CONFIG_PATH=

# Surface defect detection (YOLO11-Defect / Mask2Former)
DEFECT_DETECTION_MODEL_PATH=

# Granite type classification (ConvNeXt / EfficientNet / ViT)
GRANITE_CLASSIFICATION_MODEL_PATH=

# Depth estimation (Depth Anything V2)
DEPTH_ANYTHING_MODEL_PATH=

# Feature matching (SuperPoint + LightGlue). When unset, falls back to OpenCV SIFT/ORB (operational).
SUPERPOINT_MODEL_PATH=
LIGHTGLUE_MODEL_PATH=

# Photogrammetry (COLMAP binary). When unset, falls back to OpenCV Multi-View SfM (operational).
COLMAP_BINARY_PATH=

# ---- ArUco Calibration ----
# Physical size in centimetres of printed ArUco marker
ARUCO_MARKER_SIZE_CM=10.0
ARUCO_DICTIONARY=DICT_5X5_100

# ---- Image Upload Limits ----
MAX_IMAGE_BYTES=15728640
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
# Sequential photo capture session limits
MINIMUM_CAPTURE_IMAGES=4
MAXIMUM_CAPTURE_IMAGES=12

# ---- Demo & Seeding (development only) ----
# When DEMO_MODE=true the UI MUST display: DEMO MODE — SIMULATED RESULTS
# Production deployments MUST leave DEMO_MODE=false
DEMO_MODE=false

# Hackathon demo user seed (development only; disabled by default)
SEED_DEMO_USERS=false

# ---- Seigniorage ----
# Optional default rock density (t/m³) for indicative mass estimation.
# Leave empty to forbid volume→tonne conversion.
DEFAULT_GRANITE_DENSITY_T_M3=2.7

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=120

